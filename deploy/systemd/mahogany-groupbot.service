[Unit]
Description=Mahogany Maya group bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mahogany
EnvironmentFile=-/etc/mahogany.env
Environment=MAHOGANY_DATA_DIR=/var/lib/mahogany
ExecStart=/opt/mahogany/.venv/bin/mahogany group-bot
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
